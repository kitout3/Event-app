rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function platformAdmin() {
      return signedIn() && request.auth.uid == 'beQK5FNoVla9lnvnzSfqasK93QR2';
    }
    function event(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }
    function owns(eventId) {
      return signedIn() && event(eventId).data.ownerUid == request.auth.uid;
    }
    function manages(eventId) {
      return owns(eventId) || platformAdmin();
    }
    function active(eventId) {
      return event(eventId).data.active == true;
    }
    function privateEvent(eventId) {
      return eventId == 'quentin-huyen-2026';
    }
    function invitedToPrivateEvent(eventId) {
      return signedIn()
        && request.auth.token.email is string
        && ('privateAccessEmails' in event(eventId).data)
        && event(eventId).data.privateAccessEmails is list
        && event(eventId).data.privateAccessEmails.hasAny([request.auth.token.email]);
    }
    function attendeeAccess(eventId) {
      return manages(eventId)
        || invitedToPrivateEvent(eventId)
        || (!privateEvent(eventId) && active(eventId));
    }

    match /events/{eventId} {
      allow read: if manages(eventId)
        || invitedToPrivateEvent(eventId)
        || (!privateEvent(eventId) && resource.data.active == true);
      allow create: if platformAdmin()
        && request.resource.data.id == eventId
        && request.resource.data.slug == eventId;
      allow update: if manages(eventId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.slug == resource.data.slug
        && (
          platformAdmin()
          || (
            owns(eventId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "ownerUid", "adminEmail", "active", "status", "billing",
              "createdAt", "createdBy", "id", "slug"
            ])
          )
        );
      // Event deletion is server/platform-only so media cleanup and billing
      // history cannot be bypassed from a customer browser.
      allow delete: if platformAdmin();

      match /photos/{photoId} {
        // Guests may only query approved photos and like records. Pending and
        // rejected media stay private to the wedding administrator.
        allow read: if manages(eventId)
          || invitedToPrivateEvent(eventId)
          || (!privateEvent(eventId) && active(eventId)
            && (resource.data.status == "approved" || resource.data.type == "photoLike"));

        allow create: if attendeeAccess(eventId)
          && request.resource.data.eventId == eventId
          && (
            (
              request.resource.data.keys().hasAll(["eventId", "type", "photoId", "status"])
              && request.resource.data.type == "photoLike"
              && request.resource.data.status == "like"
              && request.resource.data.photoId is string
            )
            ||
            (
              request.resource.data.keys().hasAll(["eventId", "url", "status"])
              && request.resource.data.url is string
              && request.resource.data.status in ["pending", "approved"]
            )
          );
        allow update, delete: if manages(eventId);
      }

      match /videoTestimonials/{videoId} {
        // Public video metadata is served through listPublicVideos(), which
        // returns only approved/due media. Direct Firestore reads are admin-only.
        allow read: if manages(eventId);
        allow create: if attendeeAccess(eventId)
          && request.resource.data.eventId == eventId
          && request.resource.data.url is string
          && request.resource.data.path is string
          && request.resource.data.size is int
          && request.resource.data.size <= 500 * 1024 * 1024
          && request.resource.data.mimeType is string
          && request.resource.data.mimeType.matches('^video/(mp4|quicktime|webm)')
          && request.resource.data.status in ["pending", "approved"];
        allow update, delete: if manages(eventId);
      }

      match /guestbookMessages/{messageId} {
        allow read: if manages(eventId)
          || invitedToPrivateEvent(eventId)
          || (!privateEvent(eventId) && active(eventId) && resource.data.status == "approved");
        allow create: if attendeeAccess(eventId)
          && request.resource.data.keys().hasAll(["eventId", "message", "status"])
          && request.resource.data.eventId == eventId
          && request.resource.data.status == "approved"
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 800
          && (!request.resource.data.keys().hasAny(["author"]) || request.resource.data.author == null || request.resource.data.author is string);
        allow update, delete: if manages(eventId);
      }

      match /liveChatMessages/{messageId} {
        allow read, create: if attendeeAccess(eventId);
        allow update, delete: if manages(eventId);
      }

      match /livePresence/{sessionId} {
        allow read, create, update: if attendeeAccess(eventId);
        allow delete: if manages(eventId);
      }

      match /pushSubscriptions/{subscriptionId} {
        allow read, write: if manages(eventId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
